# ============================================
# Folder Cleanup Tool - Environment Variables
# Copy this file to .env and adjust values.
# These override config.json settings.
# ============================================

# --- App Settings ---
# Whether to run in dry-run mode by default (true/false)
FOLDER_CLEANUP_DRY_RUN=true

# Files older than this many days get archived
FOLDER_CLEANUP_ARCHIVE_AGE_DAYS=180

# Rename pattern: {name}, {ext}, {date}
FOLDER_CLEANUP_RENAME_PATTERN={name}_{date}{ext}

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR
FOLDER_CLEANUP_LOG_LEVEL=INFO

# --- Streamlit Auth (UI only) ---
# Set to "true" to enable login for the web UI
FOLDER_CLEANUP_AUTH_ENABLED=true
# Username / password for the UI login
FOLDER_CLEANUP_AUTH_USERNAME=admin
FOLDER_CLEANUP_AUTH_PASSWORD=change-me-please
